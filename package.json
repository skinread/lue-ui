{
  "name": "lue-ui-workspace",
  "private": true,
  "type": "module",
  "description": "Lue UI \u2014 a platform-native, accessibility-first design system (workspace root)",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "typecheck": "tsc -p tsconfig.packages.json && tsc -p tsconfig.json",
    "check-tokens": "node tools/directions/check-tokens.mjs && node tools/directions/palettes.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm check-tokens",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/css": "^2.0.0",
    "@html-eslint/eslint-plugin": "^0.66.1",
    "@html-eslint/parser": "^0.66.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.3",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
