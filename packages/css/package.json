{
  "name": "@lue-ui/css",
  "version": "0.0.0",
  "private": true,
  "description": "Lue UI component CSS — native CSS in @layer lue",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./lue.d.ts",
      "style": "./dist/lue.css",
      "default": "./dist/lue.css"
    },
    "./base.css": "./dist/base.css",
    "./blocks.css": "./dist/blocks.css",
    "./materials.css": "./dist/materials.css",
    "./components/*.css": "./dist/components/*.css",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./dist/fonts/*"
  },
  "files": [
    "dist",
    "lue.d.ts"
  ],
  "devDependencies": {
    "lightningcss": "1.33.0"
  },
  "scripts": {
    "build": "node scripts/build.js"
  }
}
