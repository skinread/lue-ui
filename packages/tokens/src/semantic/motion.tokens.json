{
  "$description": "Motion. Every duration becomes 0s under prefers-reduced-motion: reduce; nothing animates on its own.",
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": {
          "value": 160,
          "unit": "ms"
        },
        "$description": "Small state changes."
      },
      "moderate": {
        "$type": "duration",
        "$value": {
          "value": 240,
          "unit": "ms"
        },
        "$description": "Disclosures, switches."
      },
      "slow": {
        "$type": "duration",
        "$value": {
          "value": 320,
          "unit": "ms"
        },
        "$description": "The dance: tone drift, chrome glint, glow. The ceiling for UI transitions."
      }
    },
    "ease": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.22,
          1,
          0.36,
          1
        ],
        "$description": "Ease-out for the dance and most transitions."
      },
      "enter": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          0.2,
          1
        ],
        "$description": "Elements entering."
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          1,
          1
        ],
        "$description": "Elements leaving."
      },
      "spring": {
        "$type": "cubicBezier",
        "$value": [
          0.34,
          1.56,
          0.64,
          1
        ],
        "$description": "Small overshoot for scale. Builds prefer the linear() curve in $extensions.",
        "$extensions": {
          "lue": {
            "css": "linear(0, 0.4 12%, 0.84 28%, 1.03 45%, 1.04 55%, 1.01 75%, 1)"
          }
        }
      }
    }
  }
}
