    "max-inline-size": {
      "$type": "dimension",
      "$value": {
        "value": 28.75,
        "unit": "rem"
      },
      "$description": "Dialog maximum width."
    }
  },
  "card": {
    "radius": {
      "$type": "dimension",
      "$value": "{radius.l}",
      "$description": "Card radius."
    }
  }
