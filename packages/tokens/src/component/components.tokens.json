{
  "$description": "A few documented component knobs, defaulting to semantic tokens.",
  "button": {
    "radius": {
      "$type": "dimension",
      "$value": "{radius.full}",
      "$description": "Button corner radius."
    },
    "height": {
      "$type": "dimension",
      "$value": "{size.control.md}",
      "$description": "Default button height."
    }
  },
  "field": {
    "radius": {
      "$type": "dimension",
      "$value": {
        "value": 18,
        "unit": "px"
      },
      "$description": "Text input, select and textarea radius: a soft well."
    }
  },
  "dialog": {
