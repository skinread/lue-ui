{
  "name": "Toolbar",
  "summary": "A group of controls that is one Tab stop, with arrow keys between them.",
  "status": "experimental",
  "rung": "light-dom-script",
  "rungReason": "role=\"toolbar\" is ARIA; the roving tabindex needs <lue-roving> until focusgroup is Baseline.",
  "anatomy": {
    "toolbar": {
      "element": "lue-roving",
      "class": "lue-toolbar",
      "required": true,
      "attributes": {
        "role": "toolbar",
        "aria-label": "required",
        "aria-orientation": "vertical (optional)"
      }
    },
    "separator": {
      "element": "span",
      "required": false,
      "attributes": {
        "role": "separator"
      }
    }
  },
  "variants": {
    "orientation": {
      "attribute": "aria-orientation",
      "values": [
        "horizontal",
        "vertical"
      ],
      "default": "horizontal"
    }
  },
  "a11y": {
    "role": "toolbar",
    "name": "aria-label",
    "keyboard": [
      {
        "keys": [
          "Tab",
          "Shift+Tab"
        ],
        "action": "Into the toolbar at the last control used, and out"
      },
      {
        "keys": [
          "ArrowRight",
          "ArrowLeft"
        ],
        "action": "Next or previous control (mirrored in right-to-left text; stops at the ends)"
      },
      {
        "keys": [
          "ArrowDown",
          "ArrowUp"
        ],
        "action": "Next or previous control",
        "where": "aria-orientation=\"vertical\""
      },
      {
        "keys": [
          "Home",
          "End"
        ],
        "action": "First or last control"
      }
    ],
    "focus": {
      "indicator": "Each control's own"
    }
  },
  "ownedAttributes": {
    "controls inside": [
      "tabindex"
    ]
  },
  "elementRules": "Items are its buttons, links and form fields (enabled, not in a nested lue-roving). A text field keeps its own arrow keys.",
  "react": {
    "component": "Toolbar",
    "props": {
      "aria-label": "required",
      "orientation": "vertical",
      "children": "controls and separators"
    }
  },
  "tokens": [
    "--lue-color-border-subtle",
    "--lue-space-3xs",
    "--lue-radius-l"
  ],
  "platform": {
    "baseline": [
      "custom elements",
      "role=toolbar"
    ],
    "enhancements": [
      {
        "feature": "focusgroup",
        "fallback": "<lue-roving> (it's deleted once focusgroup is Baseline)"
      }
    ]
  },
  "rules": [
    "Only for three or more related controls; two buttons are just buttons"
  ],
  "withoutJavaScript": "Every control is a Tab stop",
  "contrast": "As its controls",
  "forcedColors": "Separators are CanvasText",
  "deletionTrigger": "focusgroup Baseline in all three engines"
}
